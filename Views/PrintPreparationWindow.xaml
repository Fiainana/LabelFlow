<Window x:Class="LabelFlow.Views.PrintPreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparation de l'impression" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F9FAFB" MinHeight="420" MinWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Quantités d'étiquettes" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Indiquez le nombre d'étiquettes à imprimer pour chaque article." FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="DgItems" Grid.Row="1" Margin="20,16,20,8" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Article.Reference}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="DÉSIGNATION" Binding="{Binding Article.Designation}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="QUANTITÉ" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Padding="24,8">
            <Grid>
                <TextBlock x:Name="TxtTotal" FontSize="13" FontWeight="Medium" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tout à 1" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Click="OnResetQtyClick"/>
                    <Button Content="+1 partout" Style="{StaticResource Btn.Secondary}" Click="OnAddOneClick"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Annuler" Style="{StaticResource Btn.Secondary}" Width="100" Margin="0,0,10,0" Click="OnCancelClick"/>
                <Button Content="Aperçu" Style="{StaticResource Btn.Secondary}" Width="100" Margin="0,0,10,0" Click="OnPreviewClick"/>
                <Button Content="Imprimer" Style="{StaticResource Btn.Primary}" Width="120" Click="OnPrintClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
