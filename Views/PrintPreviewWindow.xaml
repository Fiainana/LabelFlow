<Window x:Class="LabelFlow.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu des étiquettes — LabelFlow" Height="720" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6" MinHeight="500" MinWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <TextBlock x:Name="TxtTitle" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="Aperçu"/>
                <TextBlock x:Name="TxtInfo" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="20" Background="#E5E7EB" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
                <DocumentViewer x:Name="Viewer" Background="Transparent"/>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Fermer" Style="{StaticResource Btn.Secondary}" Width="110" Margin="0,0,10,0" Click="OnCloseClick"/>
                <Button Content="Imprimer" Style="{StaticResource Btn.Primary}" Width="130" Click="OnPrintClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
