<Window x:Class="LabelFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Height="820" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F9FAFB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,18,28,12">
            <StackPanel>
                <TextBlock Text="Connexion" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,4"/>
                <TextBlock Text="Accès à la base de données SQL." FontSize="12" Foreground="#6B7280" Margin="0,0,0,10"/>
                <TextBlock Text="Serveur / Instance" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtServer" Style="{StaticResource Input.Text}" Margin="0,0,0,8" Text="localhost\\SQLEXPRESS"/>
                <TextBlock Text="Base de données" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDatabase" Style="{StaticResource Input.Text}" Margin="0,0,0,8"/>
                <TextBlock Text="Authentification" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="RbWindows" Content="Windows" IsChecked="True" Margin="0,0,20,0" Checked="OnAuthTypeChanged"/>
                    <RadioButton x:Name="RbSql" Content="SQL Server" Checked="OnAuthTypeChanged"/>
                </StackPanel>
                <TextBlock x:Name="LblUser" Text="Utilisateur" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUser" Style="{StaticResource Input.Text}" Margin="0,0,0,8" IsEnabled="False"/>
                <TextBlock x:Name="LblPassword" Text="Mot de passe" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Height="34" Padding="12,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,8" IsEnabled="False"/>
                <Border x:Name="StatusBorder" Background="#F3F4F6" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtStatus" Text="En attente de test..." FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                </Border>
                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,14"/>
                <TextBlock Text="Imprimante" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,4"/>
                <TextBlock Text="Profil mémorisé." FontSize="12" Foreground="#6B7280" Margin="0,0,0,10"/>
                <ComboBox x:Name="CmbPrinter" Height="34" Margin="0,0,0,14" Padding="8,0" VerticalContentAlignment="Center"/>
                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,14"/>
                <TextBlock Text="Taille étiquette (mm)" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Largeur" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLabelWidth" Style="{StaticResource Input.Text}" Text="50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hauteur" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLabelHeight" Style="{StaticResource Input.Text}" Text="30"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Type code-barres" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbCode128" Content="Code 128" IsChecked="True" Margin="0,0,24,0"/>
                    <RadioButton x:Name="RbCode39" Content="Code 39"/>
                </StackPanel>
                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,14"/>
                <TextBlock Text="Design" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                    <StackPanel>
                        <RadioButton x:Name="RbDesignClassic" Content="Classique" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="RbDesignCompact" Content="Compact" Margin="0,5"/>
                        <RadioButton x:Name="RbDesignProduct" Content="Fiche produit" Margin="0,5"/>
                        <RadioButton x:Name="RbDesignIndustrial" Content="Industriel" Margin="0,5"/>
                        <RadioButton x:Name="RbDesignRetail" Content="Grand magasin" Margin="0,5"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Champs étiquette" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="ChkLabelRef" Content="Référence" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkLabelDesignation" Content="Désignation" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkLabelBarcode" Content="Code-barres" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkLabelPrice" Content="Prix (Ar)" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkLabelUnit" Content="Unité" IsChecked="False" Margin="0,4"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="ChkShowDecimals" Content="Afficher les décimales" IsChecked="True" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnTest" Content="Tester" Style="{StaticResource Btn.Secondary}" Width="120" Margin="0,0,10,0" Click="OnTestClick"/>
                <Button Content="Enregistrer" Style="{StaticResource Btn.Primary}" Width="120" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
