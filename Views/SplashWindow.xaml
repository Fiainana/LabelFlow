<Window x:Class="LabelFlow.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFlow" Height="280" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="16" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="32,28,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo + Brand -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Border Width="40" Height="40" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0">
                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M4,6 H20 V8 H4 Z M4,11 H20 V13 H4 Z M4,16 H14 V18 H4 Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LABELFLOW" FontSize="20" FontWeight="Bold" Foreground="White"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Advanced Labeling Solutions" FontSize="11" Foreground="#94A3B8"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Message de chargement -->
            <TextBlock Grid.Row="1"
                       x:Name="TxtLoading"
                       Text="Connexion aux services d'impression..."
                       FontSize="13"
                       Foreground="#CBD5E1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,18,0,14"/>

            <!-- Progress bar -->
            <Border Grid.Row="2" Height="4" CornerRadius="2" Background="#1E293B" Margin="8,0,8,18">
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Foreground="#3B82F6"
                             Background="Transparent"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="Transparent" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#3B82F6" CornerRadius="2"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3">
                <TextBlock Text="Sécurisé et Prêt."
                           FontSize="11"
                           Foreground="#64748B"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="by " Foreground="#64748B" FontSize="11"/>
                    <Run Text="Aikflow" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
