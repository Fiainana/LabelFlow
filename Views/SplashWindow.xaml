<Window x:Class="LabelFlow.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFlow" Height="340" Width="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.16" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="12" Background="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="LabelFlow" FontSize="28" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock Text="Impression d'étiquettes" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="48,0,48,28" HorizontalAlignment="Center">
                <ProgressBar Height="3" Width="220" IsIndeterminate="True" Foreground="#2563EB" Background="#E5E7EB"/>
                <TextBlock x:Name="TxtLoading" Text="Chargement..." FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="by AikFlow" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,18"/>
        </Grid>
    </Border>
</Window>
